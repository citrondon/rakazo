[Unit]
Description=Create and verify a BobBot production backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
# The old config directory stays readable so an install that already has
# /etc/rakazo/backup.env keeps its settings; a value in the new file wins.
EnvironmentFile=-/etc/rakazo/backup.env
EnvironmentFile=-/etc/bobbot/backup.env
ExecStart=/usr/local/sbin/bobbot-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups
