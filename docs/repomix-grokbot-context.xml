def main():
    parser = argparse.ArgumentParser(
        description="Google Assistant Tool für Rakazo & ExecutiveChief (Calendar & Gmail)",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    subparsers = parser.add_subparsers(dest="command", help="Verfügbare Befehle")

    # calendar
    cal_parser = subparsers.add_parser("calendar", help="Google Kalender abfragen")
    cal_parser.add_argument("-d", "--days", type=int, default=7, help="Tage in die Zukunft (Standard: 7)")
    cal_parser.add_argument("-f", "--format", choices=["table", "json"], default="table", help="Ausgabeformat")

    # mail
    mail_parser = subparsers.add_parser("mail", help="Gmail ungelesene Mails abfragen")
    mail_parser.add_argument("-n", "--limit", type=int, default=5, help="Anzahl Mails (Standard: 5)")
    mail_parser.add_argument("-f", "--format", choices=["table", "json"], default="table", help="Ausgabeformat")

    # draft
    draft_parser = subparsers.add_parser("draft", help="E-Mail-Entwurf anlegen (erfordert menschliche Freigabe)")
    draft_parser.add_argument("--to", required=True, help="Empfänger-Adresse")
    draft_parser.add_argument("--subject", required=True, help="Betreff")
    draft_parser.add_argument("--body", required=True, help="Inhalt")
    draft_parser.add_argument("--reply-to", dest="reply_to", help="Original Mail-ID")
    draft_parser.add_argument("-f", "--format", choices=["table", "json"], default="table", help="Ausgabeformat")

    # send
    send_parser = subparsers.add_parser("send", help="E-Mail versenden (nach Freigabe)")
    send_parser.add_argument("--draft-id", dest="draft_id", help="Entwurfs-ID zur Freigabe")
    send_parser.add_argument("--to", help="Empfänger-Adresse")
    send_parser.add_argument("--subject", help="Betreff")
    send_parser.add_argument("--body", help="Inhalt")
    send_parser.add_argument("--confirm", action="store_true", help="Bestätigung der menschlichen Freigabe (Approval)")
    send_parser.add_argument("-f", "--format", choices=["table", "json"], default="table", help="Ausgabeformat")

    # briefing
    brief_parser = subparsers.add_parser("briefing", help="Komplettes Executive Morning Briefing (Kalender + Mails)")
    brief_parser.add_argument("-f", "--format", choices=["table", "json"], default="table", help="Ausgabeformat")

    # status
    subparsers.add_parser("status", help="Prüft Konfiguration und Verbindungsstatus")

    args = parser.parse_args()
    cfg = load_config()

    if not args.command or args.command == "status":
        print_status(cfg)
        return

    if args.command == "calendar":
        events = CalendarService.get_agenda(cfg.get("calendar_ical_url", ""), days=args.days)
        if args.format == "json":
            clean = []
            for ev in events:
                c = dict(ev)
                c.pop("start", None)
                c.pop("end", None)
                clean.append(c)
            print(json.dumps(clean, indent=2, ensure_ascii=False))
        else:
            render_calendar_table(events)

    elif args.command == "mail":
        emails = GmailService.get_unread(cfg.get("gmail_user", ""), cfg.get("gmail_app_password", ""), limit=args.limit)
        if args.format == "json":
            print(json.dumps(emails, indent=2, ensure_ascii=False))
        else:
            render_mail_table(emails)

    elif args.command == "draft":
        draft = DraftManager.create_draft(args.to, args.subject, args.body, args.reply_to)
        if args.format == "json":
            print(json.dumps(draft, indent=2, ensure_ascii=False))
        else:
            print("\n=======================================================")
            print(" 📝 E-MAIL ENTWURF ERSTELLT (APPROVAL ERFORDERLICH)")
            print("=======================================================")
            print(f"• Draft-ID:   {draft['id']}")
            print(f"• An:         {draft['to']}")
            print(f"• Betreff:    {draft['subject']}")
            print(f"• Status:     ⚠️ {draft['status']} (Wartet auf Freigabe)")
            print("-------------------------------------------------------")
            print(f"{draft['body']}")
            print("=======================================================")
            print("💡 Freigabe erfolgt über: python google_assistant.py send --draft-id " + draft['id'] + " --confirm\n")

    elif args.command == "send":
        if not args.confirm:
            print("❌ ABGEBROCHEN: Das Versenden von E-Mails erfordert explizite Bestätigung mit dem Flag --confirm.", file=sys.stderr)
            sys.exit(1)

        to = args.to
        subject = args.subject
        body = args.body

        if args.draft_id:
            updated = DraftManager.mark_sent(args.draft_id)
            if updated:
                to = updated.get("to")
                subject = updated.get("subject")
                body = updated.get("body")

        # Ausführung (Demo oder SMTP)
        has_smtp = bool(cfg.get("gmail_user") and cfg.get("gmail_app_password"))
        if has_smtp:
            try:
                import smtplib
                from email.mime.text import MIMEText
                msg = MIMEText(body or "", "plain", "utf-8")
                msg["Subject"] = subject or ""
                msg["From"] = cfg["gmail_user"]
                msg["To"] = to or ""
                with smtplib.SMTP_SSL("smtp.gmail.com", 465) as server:
                    server.login(cfg["gmail_user"], cfg["gmail_app_password"])
                    server.send_message(msg)
                status_msg = "Erfolgreich via Gmail SMTP versendet!"
            except Exception as e:
                status_msg = f"Fehler beim SMTP-Versand: {e}"
        else:
            status_msg = "Erfolgreich im Demo-Modus als gesendet markiert (Keine echten SMTP-Keys konfiguriert)."

        res = {
            "status": "SENT",
            "to": to,
            "subject": subject,
            "details": status_msg,
            "timestamp": datetime.now().isoformat()
        }
        if args.format == "json":
            print(json.dumps(res, indent=2, ensure_ascii=False))
        else:
            print(f"\n✅ {status_msg}")
            print(f"• Empfänger: {to}")
            print(f"• Betreff:   {subject}\n")

    elif args.command == "briefing":
        events = CalendarService.get_agenda(cfg.get("calendar_ical_url", ""), days=1)
        emails = GmailService.get_unread(cfg.get("gmail_user", ""), cfg.get("gmail_app_password", ""), limit=5)
        # Automatisches Logging ins Second Brain
        archive_daily_briefing(events, emails)

        if args.format == "json":
            clean_events = []
            for ev in events:
                c = dict(ev)
                c.pop("start", None)
                c.pop("end", None)
                clean_events.append(c)
            res = {
                "generated_at": datetime.now().isoformat(),
                "agenda": clean_events,
                "unread_emails": emails,
                "second_brain_archived": True,
            }
            print(json.dumps(res, indent=2, ensure_ascii=False))
        else:
            render_briefing(events, emails)


if __name__ == "__main__":
    main()
