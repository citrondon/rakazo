            },
            {
                "id": "1003",
                "from": "Google Cloud Billing <billing-noreply@google.com>",
                "subject": "Monatlicher Budget-Report: 85% unter dem Limit",
                "date": (now - timedelta(hours=5)).strftime("%a, %d %b %Y %H:%M:%S +0200"),
                "is_unread": True,
                "priority": "LOW"
            }
        ]
        return demo[:limit]


