# Standard-Konfigurationspfade
CONFIG_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "google_config.json")


def load_config() -> Dict[str, str]:
    """Lädt Konfiguration aus Umgebungsvariablen oder lokaler JSON-Datei."""
    cfg = {
        "gmail_user": os.getenv("GMAIL_USER", ""),
        "gmail_app_password": os.getenv("GMAIL_APP_PASSWORD", ""),
        "calendar_ical_url": os.getenv("GOOGLE_CALENDAR_ICAL_URL", ""),
    }
    if os.path.isfile(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                if isinstance(data, dict):
                    for k in ["gmail_user", "gmail_app_password", "calendar_ical_url"]:
                        if not cfg.get(k) and data.get(k):
                            cfg[k] = str(data[k])
        except Exception:
            pass
    return cfg


def decode_mime_header(val: Optional[str]) -> str:
    """Dekodiert MIME Header (z. B. UTF-8 encoded Subject)."""
    if not val:
        return ""
    try:
        parts = decode_header(val)
        res = []
        for text, enc in parts:
            if isinstance(text, bytes):
                res.append(text.decode(enc or "utf-8", errors="replace"))
            else:
                res.append(str(text))
        return "".join(res)
    except Exception:
        return val


class CalendarService:
    """Verarbeitet Google Calendar Termine via privatem iCal/ICS Feed."""

    @staticmethod
    def parse_ics(ics_content: str, days_ahead: int = 7) -> List[Dict[str, Any]]:
        events = []
        lines = ics_content.replace("\r\n ", "").replace("\n ", "").splitlines()
        
        current_event: Optional[Dict[str, Any]] = None
        now = datetime.now()
        start_bound = datetime.combine(date.today(), datetime.min.time())
        end_bound = start_bound + timedelta(days=days_ahead)

        for line in lines:
            line = line.strip()
            if line == "BEGIN:VEVENT":
                current_event = {}
            elif line == "END:VEVENT" and current_event is not None:
                if "summary" in current_event and "start" in current_event:
                    dt_start = current_event["start"]
                    # Filter nach Datumsbereich
                    if start_bound <= dt_start <= end_bound:
                        current_event["start_iso"] = dt_start.isoformat()
                        if "end" in current_event:
                            current_event["end_iso"] = current_event["end"].isoformat()
                        events.append(current_event)
                current_event = None
            elif current_event is not None:
                if line.startswith("SUMMARY:"):
                    current_event["summary"] = line[len("SUMMARY:"):].strip()
                elif line.startswith("LOCATION:"):
                    current_event["location"] = line[len("LOCATION:"):].strip()
                elif line.startswith("DESCRIPTION:"):
                    current_event["description"] = line[len("DESCRIPTION:"):].strip()
                elif line.startswith("DTSTART"):
                    val = line.split(":", 1)[-1].strip()
                    dt = CalendarService._parse_ics_date(val)
                    if dt:
                        current_event["start"] = dt
                elif line.startswith("DTEND"):
                    val = line.split(":", 1)[-1].strip()
                    dt = CalendarService._parse_ics_date(val)
                    if dt:
                        current_event["end"] = dt

        events.sort(key=lambda x: x["start"])
        return events

    @staticmethod
    def _parse_ics_date(val: str) -> Optional[datetime]:
        # Formate: 20260930T090000Z oder 20260930T090000 oder 20260930 (Ganztags)
        val = val.rstrip("Z")
        try:
            if "T" in val:
                return datetime.strptime(val[:15], "%Y%m%dT%H%M%S")
            return datetime.strptime(val[:8], "%Y%m%d")
        except Exception:
            return None

    @classmethod
    def get_agenda(cls, ical_url: str, days: int = 7) -> List[Dict[str, Any]]:
        if not ical_url:
            return cls.get_demo_events(days)
        try:
            req = urllib.request.Request(
                ical_url,
                headers={"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) RakazoGoogleAssistant/0.1"}
            )
            with urllib.request.urlopen(req, timeout=12) as resp:
                content = resp.read().decode("utf-8", errors="replace")
                return cls.parse_ics(content, days_ahead=days)
        except Exception as e:
            print(f"[WARN] Kalender-Abruf fehlgeschlagen ({e}), wechsle zu Demo-Modus.", file=sys.stderr)
            return cls.get_demo_events(days)

    @staticmethod
    def get_demo_events(days: int = 7) -> List[Dict[str, Any]]:
        today = date.today()
        demo = [
            {
                "summary": "🎯 Daily Architecture & Sprint Alignment",
                "start": datetime.combine(today, datetime.min.time()).replace(hour=9, minute=30),
                "end": datetime.combine(today, datetime.min.time()).replace(hour=10, minute=15),
                "location": "Google Meet (virtuell)",
                "description": "Sprint Review und Roadmap-Abstimmung mit dem Team",
            },
            {
                "summary": "💼 Client Strategy Meeting: Q4 Automation",
                "start": datetime.combine(today, datetime.min.time()).replace(hour=14, minute=0),
                "end": datetime.combine(today, datetime.min.time()).replace(hour=15, minute=0),
                "location": "Büro / Zoom",
