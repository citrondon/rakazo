class DraftManager:
    """Verwaltet E-Mail-Entwürfe und Approval-Gates unter workspace/notes/inbox/drafts.json."""

    @staticmethod
    def get_drafts_file() -> str:
        inbox_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "notes", "inbox"))
        os.makedirs(inbox_dir, exist_ok=True)
        return os.path.join(inbox_dir, "drafts.json")

    @classmethod
    def load_drafts(cls) -> List[Dict[str, Any]]:
        path = cls.get_drafts_file()
        if os.path.isfile(path):
            try:
                with open(path, "r", encoding="utf-8") as f:
                    return json.load(f)
            except Exception:
                return []
        return []

    @classmethod
    def save_drafts(cls, drafts: List[Dict[str, Any]]):
        path = cls.get_drafts_file()
        with open(path, "w", encoding="utf-8") as f:
            json.dump(drafts, f, indent=2, ensure_ascii=False)

    @classmethod
    def create_draft(cls, to: str, subject: str, body: str, reply_to_id: Optional[str] = None) -> Dict[str, Any]:
        drafts = cls.load_drafts()
        draft_id = f"draft_{Date_now_id()}"
        draft = {
            "id": draft_id,
            "to": to,
            "subject": subject,
            "body": body,
            "reply_to_id": reply_to_id,
            "created_at": datetime.now().isoformat(),
            "status": "WAITING_APPROVAL",
            "approval_required": True,
        }
        drafts.append(draft)
        cls.save_drafts(drafts)
        return draft

    @classmethod
    def mark_sent(cls, draft_id: str) -> Optional[Dict[str, Any]]:
        drafts = cls.load_drafts()
        for d in drafts:
            if d.get("id") == draft_id:
                d["status"] = "SENT"
                d["sent_at"] = datetime.now().isoformat()
                cls.save_drafts(drafts)
                return d
        return None


def Date_now_id() -> str:
    return datetime.now().strftime("%Y%m%d_%H%M%S")


def print_status(cfg: Dict[str, str]):
