                "end": datetime.combine(today + timedelta(days=1), datetime.min.time()).replace(hour=11, minute=45),
                "location": "Google Meet",
                "description": "Live-Vorführung von PWA, Routinen und Gmail Assistant",
            }
        ]
        for e in demo:
            e["start_iso"] = e["start"].isoformat()
            e["end_iso"] = e["end"].isoformat()
        return [e for e in demo if (e["start"].date() - today).days <= days]


class GmailService:
    """Verarbeitet Gmail Nachrichten via IMAP SSL (Port 993)."""

    @classmethod
    def get_unread(cls, user: str, password: str, limit: int = 5) -> List[Dict[str, Any]]:
        if not user or not password:
            return cls.get_demo_emails(limit)
        try:
            mail = imaplib.IMAP4_SSL("imap.gmail.com", 993)
            mail.login(user, password)
            mail.select("INBOX", readonly=True)

            status, search_data = mail.search(None, "UNSEEN")
            if status != "OK" or not search_data[0]:
                mail.logout()
                return []

            msg_ids = search_data[0].split()
            # Neueste Mails zuerst
            msg_ids = msg_ids[-limit:][::-1]
            emails = []

            for mid in msg_ids:
                res, data = mail.fetch(mid, "(RFC822.HEADER)")
                if res != "OK":
                    continue
                raw = data[0][1]
                msg = email.message_from_bytes(raw)
                
                subject = decode_mime_header(msg.get("Subject", "(Kein Betreff)"))
                sender = decode_mime_header(msg.get("From", "Unbekannt"))
                date_str = msg.get("Date", "")
                
                emails.append({
                    "id": mid.decode("ascii", errors="ignore"),
                    "from": sender,
                    "subject": subject,
                    "date": date_str,
                    "is_unread": True
                })

            mail.logout()
            return emails
        except Exception as e:
            print(f"[WARN] Gmail-Abfrage fehlgeschlagen ({e}), wechsle zu Demo-Modus.", file=sys.stderr)
            return cls.get_demo_emails(limit)

    @staticmethod
    def get_demo_emails(limit: int = 5) -> List[Dict[str, Any]]:
        now = datetime.now()
        demo = [
            {
                "id": "1001",
                "from": "GitHub Notifications <notifications@github.com>",
                "subject": "[Security Alert] Rakazo Routine Pipeline: Dependencies up to date",
