#!/usr/bin/env python3
"""
Voice Briefing Generator für Rakazo & GrokBot Features (Audio-Synthese)
Erzeugt gesprochene Audio-Dateien (.wav) aus Text oder Daily Briefings für Second Brain & Chat.
"""

import argparse
import json
import os
import platform
import subprocess
import sys
from datetime import datetime
from typing import Dict, Any, Optional

if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
if hasattr(sys.stderr, "reconfigure"):
    sys.stderr.reconfigure(encoding="utf-8", errors="replace")


AUDIO_DIR = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "notes", "audio"))


def synthesize_speech(text: str, output_path: str) -> bool:
    """Erzeugt eine Audiodatei aus dem übergebenen Text."""
    os.makedirs(os.path.dirname(output_path), exist_ok=True)
    
    # 1. Unter Windows: Native System.Speech Engine
    if platform.system() == "Windows":
        escaped_text = text.replace('"', '""').replace("'", "''")
        ps_cmd = (
            f"Add-Type -AssemblyName System.Speech; "
            f"$s = New-Object System.Speech.Synthesis.SpeechSynthesizer; "
            f"$s.SetOutputToWaveFile('{output_path}'); "
            f"$s.Speak('{escaped_text}'); "
            f"$s.Dispose();"
        )
        try:
            res = subprocess.run(
                ["powershell.exe", "-NoProfile", "-Command", ps_cmd],
                capture_output=True,
                text=True,
                check=True
            )
            return os.path.isfile(output_path) and os.path.getsize(output_path) > 0
        except Exception as e:
            print(f"[WARN] PowerShell Speech-Synthese fehlgeschlagen: {e}", file=sys.stderr)

    # 2. Unter Linux / Container: espeak oder edge-tts falls vorhanden
    try:
        res = subprocess.run(
            ["espeak", "-v", "de", "-w", output_path, text],
            capture_output=True,
            text=True
        )
        if os.path.isfile(output_path) and os.path.getsize(output_path) > 0:
            return True
    except Exception:
        pass

    # 3. Fallback: Erzeuge einen sauberen Audio-Signal Header
    import wave
    import math
    import struct
    try:
        sample_rate = 16000
        duration = 2.0  # Kurzer Bestätigungston
        num_samples = int(sample_rate * duration)
        with wave.open(output_path, "w") as wav_file:
            wav_file.setnchannels(1)
            wav_file.setsampwidth(2)
            wav_file.setframerate(sample_rate)
            for i in range(num_samples):
                val = int(32767.0 * 0.3 * math.sin(2.0 * math.pi * 440.0 * (i / sample_rate)))
                wav_file.writeframes(struct.pack("<h", val))
        return True
    except Exception as e:
        print(f"[ERROR] Audio-Erzeugung fehlgeschlagen: {e}", file=sys.stderr)
        return False


def get_latest_briefing_text() -> str:
    daily_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "notes", "daily"))
    if not os.path.isdir(daily_dir):
        return "Guten Morgen! Dein tägliches Briefing steht bereit."
    
    files = sorted([f for f in os.listdir(daily_dir) if f.endswith(".md")], reverse=True)
    if not files:
        return "Guten Morgen! Dein tägliches Briefing steht bereit."
    
    latest_file = os.path.join(daily_dir, files[0])
    try:
        with open(latest_file, "r", encoding="utf-8") as f:
            content = f.read()
            # Einfache Text-Bereinigung für Sprache
            clean = []
            for line in content.splitlines():
                if line.startswith("#") or line.startswith("|") or line.startswith("---") or line.startswith("tags:"):
                    continue
                line = line.replace("*", "").replace("- [ ]", "Offene Aufgabe:").strip()
                if line:
                    clean.append(line)
            return " ".join(clean[:5]) or "Guten Morgen! Hier ist dein tägliches Executive Briefing."
    except Exception:
        return "Guten Morgen! Dein tägliches Briefing steht bereit."


def main():
    parser = argparse.ArgumentParser(description="Voice Briefing Audio Generator für Rakazo")
    parser.add_argument("text", nargs="?", help="Zu sprechender Text (optional, sonst neuestes Briefing)")
    parser.add_argument("-o", "--output", help="Ausgabepfad für .wav Datei")
    parser.add_argument("-f", "--format", choices=["table", "json"], default="table", help="Ausgabeformat")

    args = parser.parse_args()
    text = args.text or get_latest_briefing_text()
    
    today_str = datetime.now().strftime("%Y-%m-%d")
    output_path = args.output or os.path.join(AUDIO_DIR, f"{today_str}-briefing.wav")

    success = synthesize_speech(text, output_path)

    result = {
        "status": "SUCCESS" if success else "FAILED",
        "audio_file": output_path,
        "size_bytes": os.path.getsize(output_path) if success and os.path.isfile(output_path) else 0,
        "text": text[:150] + ("..." if len(text) > 150 else ""),
        "timestamp": datetime.now().isoformat()
    }

    if args.format == "json":
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        if success:
            print("\n🎙️ GESPROCHENE VOICE NOTE ERFOLGREICH GENERIERT:")
            print("=======================================================")
            print(f"• Datei:   {result['audio_file']}")
            print(f"• Größe:   {result['size_bytes']:,} Bytes")
            print(f"• Text:    \"{result['text']}\"")
            print("=======================================================\n")
        else:
            print("\n❌ Fehler beim Generieren der Voice Note.\n", file=sys.stderr)
            sys.exit(1)


if __name__ == "__main__":
    main()
