HACKER_NEWS_ITEM = "https://hacker-news.firebaseio.com/v0/item/{}.json"
GITHUB_TRENDING = "https://github.com/trending/{language}?since={since}"
DEVTO_API = "https://dev.to/api/articles?state=rising&per_page={limit}"

class HackerNewsSource:
    """HackerNews API (Firebase)"""
    
    @staticmethod
    def fetch_top_story_ids(limit: int = 10) -> List[int]:
        """Holt Top-Story-IDs von HackerNews"""
        try:
            with urllib.request.urlopen(HACKER_NEWS_TOPSTORIES, timeout=10) as response:
                story_ids = json.loads(response.read().decode('utf-8'))
                return story_ids[:limit]
        except (urllib.error.URLError, json.JSONDecodeError, timeout) as e:
            print(f"[ERROR] HackerNews API-Fehler: {e}", file=sys.stderr)
            return []
    
    @staticmethod
    def fetch_item(item_id: int) -> Optional[Dict[str, Any]]:
        """Holt Details für eine einzelne Story"""
        try:
            url = HACKER_NEWS_ITEM.format(item_id)
            with urllib.request.urlopen(url, timeout=10) as response:
                return json.loads(response.read().decode('utf-8'))
        except (urllib.error.URLError, json.JSONDecodeError):
            return None
    
    @staticmethod
    def get_stories(limit: int = 10, hn_type: Optional[str] = None) -> List[Dict[str, Any]]:
        """Holt HackerNews-Stories (Top/Show/Ask/Job)"""
        story_ids = HackerNewsSource.fetch_top_story_ids(limit)
        stories = []
        
        for item_id in story_ids:
            item = HackerNewsSource.fetch_item(item_id)
            if not item:
                continue
                
            # Typfilterung
            if hn_type and item.get('type') != hn_type:
                continue
                
            # Erstelle einheitliches Item (nur Stories für Top, alle für alle)
            if item.get('type') in ['story', 'show HN', 'ask HN']:
                # Normalisiere den Titel
                title = item.get('title', '')
                if title.startswith('show HN: '):
                    title = title[9:]
                elif title.startswith('ask HN: '):
                    title = title[8:]
                
                stories.append({
                    'source': 'hackernews',
                    'type': item.get('type', 'story'),
                    'id': item.get('id'),
                    'title': title,
                    'url': item.get('url', ''),
                    'author': item.get('by', ''),
                    'score': item.get('score', 0),
                    'comments': item.get('descendants', 0),
                    'created_at': datetime.fromtimestamp(item.get('time', 0), tz=timezone.utc).isoformat(),
                    'metadata': {
                        'hn_type': item.get('type'),
                        'parent_id': item.get('parent')
                    }
                })
        
        return stories
