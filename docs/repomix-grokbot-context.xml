            return []
def format_table(stories: List[Dict[str, Any]], max_rows: Optional[int] = None) -> str:
    """Erstellt eine schöne Markdown-Tabelle für die Ausgabe"""
    if not stories:
        return "Keine Daten"
    
    limit = max_rows or len(stories)
    lines = []
    
    # Header
    lines.append("┏━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━┳━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━┓")
    lines.append("┃ #  ┃ Title                                                                          ┃ Src  ┃ Score ┃ Time                ┃")
    lines.append("┣━━━━╋━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╋━━━━━━╋━━━━━━━╋━━━━━━━━━━━━━━━━━━━━━┫")
    
    # Zeilen
    for i, story in enumerate(stories[:limit], 1):
        # Kürze Titel für bessere Formatierung
        title = story['title'][:80]
        if len(story['title']) > 80:
            title += "..."
        
        # Source-Abkürzung
        src_abbr = {
            'hackernews': 'HN',
            'github': 'GH', 
            'devto': 'DT'
        }.get(story['source'], '??')
        
        # Zeitformatierung
        time_str = "N/A"
        try:
            created = datetime.fromisoformat(story['created_at'].replace('Z', '+00:00'))
            now = datetime.now(timezone.utc)
            diff = now - created
            
            if diff.total_seconds() < 3600:
                hours = int(diff.total_seconds() / 3600)
                time_str = f"{hours}h ago" if hours > 0 else "< 1h ago"
            elif diff.total_seconds() < 86400:
                minutes = int(diff.total_seconds() / 60)
                time_str = f"{minutes}m ago"
            else:
                days = int(diff.total_seconds() / 86400)
                time_str = f"{days}d ago"
        except:
            time_str = story['created_at'][:10] if len(story['created_at']) > 10 else story['created_at']
        
        # Score-Anzeige
        score = story['score']
        if story['source'] == 'github':
            score_str = f"{score}★"
        else:
            score_str = f"{score}↑"
        
        line = f"┃ {i:<2} ┃ {title:<80} ┃ {src_abbr:<3} ┃ {score_str:<6} ┃ {time_str:<19} ┃"
        lines.append(line)
    
    # Footer
    lines.append("┗━━━━┻━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┻━━━━━━┻━━━━━━━┻━━━━━━━━━━━━━━━━━━━━━┛")
    
    return "\n".join(lines)
def format_json(stories: List[Dict[str, Any]], format_type: str = "json") -> str:
    """Erstellt JSON oder JSONL-Ausgabe"""
    if format_type == "jsonl":
        # Eine Zeile pro JSON-Objekt
        return "\n".join(json.dumps(story, ensure_ascii=False) for story in stories)
    else:
        # Vollständiges JSON-Array
        return json.dumps(stories, ensure_ascii=False, indent=2)
def format_csv(stories: List[Dict[str, Any]]) -> str:
    """Erstellt CSV-Ausgabe"""
    if not stories:
        return ""
    
    lines = []
    # Header
    lines.append("source,type,id,title,url,author,score,created_at")
    
    # Zeilen
    for story in stories:
        # Escaliere CSV-Werte
        def escape_csv(value):
            if value is None:
                return ""
            value = str(value)
            if "," in value or '"' in value or "'" in value:
                escaped = value.replace('"', '""')
                return f'"{escaped}"'
            return value
        
        row = [
            escape_csv(story['source']),
            escape_csv(story['type']),
            escape_csv(story['id']),
            escape_csv(story['title']),
            escape_csv(story['url']),
            escape_csv(story['author']),
            escape_csv(story['score']),
            escape_csv(story['created_at'])
        ]
        lines.append(",".join(row))
    
    return "\n".join(lines)


def fetch_hn(limit: int = 10, hn_type: Optional[str] = None, **kwargs) -> List[Dict[str, Any]]:
    """HackerNews Command"""
    stories = HackerNewsSource.get_stories(limit, hn_type)
    
    # Filter nach Mindest-Score
    min_score = kwargs.get('min_score', 0)
    filtered = [s for s in stories if s.get('score', 0) >= min_score]
    
    return filtered


def fetch_github(language: str = "", since: str = "daily", limit: int = 10, **kwargs) -> List[Dict[str, Any]]:
    """GitHub Command"""
    stories = GitHubSource.fetch_trending(language, since, limit)
    
    # Filter nach Mindest-Score
    min_score = kwargs.get('min_score', 0)
    filtered = [s for s in stories if s.get('score', 0) >= min_score]
    
    return filtered


def fetch_devto(limit: int = 10, **kwargs) -> List[Dict[str, Any]]:
    """Dev.to Command"""
    stories = DevtoSource.fetch_trending(limit)
    
    # Filter nach Mindest-Score
    min_score = kwargs.get('min_score', 0)
    filtered = [s for s in stories if s.get('score', 0) >= min_score]
    
    return filtered


def fetch_all(sources: List[str], **kwargs) -> List[Dict[str, Any]]:
    """Aggregiert alle Sources"""
    all_stories = []
    limit = kwargs.get('limit', 10)
    
    for source in sources:
        if source == 'hackernews':
            stories = fetch_hn(limit=limit, hn_type=kwargs.get('hn_type'), **kwargs)
        elif source == 'github':
            stories = fetch_github(
                language=kwargs.get('language', ''),
                since=kwargs.get('since', 'daily'),
                limit=limit,
                **kwargs
            )
        elif source == 'devto':
            stories = fetch_devto(limit=limit, **kwargs)
        else:
            print(f"[WARNUNG] Unbekannte Source: {source}", file=sys.stderr)
            continue
            
        all_stories.extend(stories)
    
    return all_stories


def main():
    parser = argparse.ArgumentParser(
        description="Lean Python CLI Tool für Tech- & Trend-Überwachung",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Beispiele:
  %(prog)s hn -n 20                     # HackerNews Top 20 als Tabelle
  %(prog)s github -l python -s weekly   # GitHub Trending Python weekly
  %(prog)s all --min-score 100          # Alle Sources, Filter Score >= 100
  %(prog)s hn -f json --quiet           # Nur JSON auf stdout
        """
    )
    parser.add_argument('-V', '--version', action='version', version=f'%(prog)s {__version__}')
    
    # Global Options for all subcommands
    parent_parser = argparse.ArgumentParser(add_help=False)
    parent_parser.add_argument('-n', '--limit', type=int, default=10,
                               help='Anzahl Items pro Source (Default: 10)')
    parent_parser.add_argument('-f', '--format', choices=['table', 'json', 'jsonl', 'csv'],
                              default='table', help='Output-Format (Default: table)')
    parent_parser.add_argument('-o', '--output', type=str, default='-',
                              help='Dateipfad für Output (- für stdout)')
    parent_parser.add_argument('--min-score', type=int, default=0,
                              help='Mindest-Score/Stars Filter')
    parent_parser.add_argument('-q', '--quiet', action='store_true',
                              help='Quiet Mode: Nur Daten auf stdout')

    # Hauptbefehle
    subparsers = parser.add_subparsers(dest='command', required=True,
                                       help='Command (hn, github, devto, all)')

    # Subcommand: hn
    hn_parser = subparsers.add_parser('hn', parents=[parent_parser], help='HackerNews Top Stories')
    hn_parser.add_argument('--type', dest='hn_type', choices=['story', 'show HN', 'ask HN', 'job'],
                           default=None, help='Filter nach HN Typ')

    # Subcommand: github
    gh_parser = subparsers.add_parser('github', parents=[parent_parser], help='GitHub Trending Repos')
    gh_parser.add_argument('-l', '--language', type=str, default='', help='Programmiersprache (z.B. python, rust)')
    gh_parser.add_argument('-s', '--since', choices=['daily', 'weekly', 'monthly'], default='daily', help='Zeitfenster')

    # Subcommand: devto
    subparsers.add_parser('devto', parents=[parent_parser], help='Dev.to Trending Articles')

    # Subcommand: all
    all_parser = subparsers.add_parser('all', parents=[parent_parser], help='Aggregiert alle Sources')
    all_parser.add_argument('-l', '--language', type=str, default='', help='Sprache-Filter für GitHub')
    all_parser.add_argument('-s', '--since', choices=['daily', 'weekly', 'monthly'], default='daily')

    args = parser.parse_args()

    # Data fetching
    if not args.quiet:
        print(f"[*] Starte Trend-Abfrage für '{args.command}' (Limit: {args.limit})...", file=sys.stderr)

    params = vars(args).copy()
    cmd = params.pop('command')
    output_format = params.pop('format')
    output_path = params.pop('output')
    quiet = params.pop('quiet')

    if cmd == 'hn':
        results = fetch_hn(**params)
    elif cmd == 'github':
        results = fetch_github(**params)
    elif cmd == 'devto':
        results = fetch_devto(**params)
    elif cmd == 'all':
        results = fetch_all(['hackernews', 'github', 'devto'], **params)
    else:
        results = []

    # Format output
    if args.format == 'json':
        output = format_json(results, format_type='json')
    elif args.format == 'jsonl':
        output = format_json(results, format_type='jsonl')
    elif args.format == 'csv':
        output = format_csv(results)
    else:
        output = format_table(results, max_rows=args.limit)

    # Destination
    if args.output == '-':
        print(output)
    else:
        with open(args.output, 'w', encoding='utf-8') as f:
            f.write(output)
        if not args.quiet:
            print(f"[OK] Gespeichert in: {args.output}", file=sys.stderr)


if __name__ == '__main__':
    main()
